{
  "name": "valhala-of-valkyrie",
  "version": "0.0.0",
  "description": "Ailrun's GitHub Blog",
  "scripts": {
    "build": "gatsby build",
    "check": "npm-run-all --serial checker:*",
    "checker:compile": "tsc --noEmit -p .",
    "checker:lint": "eslint . --ext ts --ext tsx",
    "release": "gh-pages -d public -t -b master -m \"Update from Gatsby\" -o Ailrun",
    "serve": "gatsby serve",
    "start": "gatsby develop",
    "preload-fonts": "gatsby-preload-fonts"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "dotenv": "^17.4.2",
    "gatsby": "^5.16.1",
    "gatsby-plugin-catch-links": "^5.16.0",
    "gatsby-plugin-csp": "^1.1.4",
    "gatsby-plugin-custom-eslint": "file:./plugins/gatsby-plugin-custom-eslint",
    "gatsby-plugin-custom-ts-checker": "file:./plugins/gatsby-plugin-custom-ts-checker",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-preload-fonts": "^4.16.0",
    "gatsby-plugin-react-helmet-async": "^1.2.3",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-typescript": "^5.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-katex": "^7.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-json": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gh-pages": "^6.3.0",
    "katex": "^0.13.24",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@types/gatsbyjs__reach-router": "^2.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser": "$@typescript-eslint/parser",
    "gatsby": {
      "eslint": "$eslint",
      "react-server-dom-webpack": {
        "react": "$react"
      }
    }
  },
  "private": true,
  "allowScripts": {
    "sharp@0.32.6": true,
    "gatsby@5.16.1": true,
    "gatsby-cli@5.16.0": true
  }
}
